# =============================================================
# ScamShield AI - environment template
# Copy this file to ".env" and fill in real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Windows (cmd):         copy .env.example .env
#   macOS / Linux:         cp .env.example .env
# NEVER commit the real .env file to Git.
# =============================================================

# ---------- Application ----------
APP_NAME=ScamShield AI
ENVIRONMENT=development          # development | staging | production
# Keep DEBUG=false on anything reachable by other people.
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# uvicorn workers used by the production profile / Dockerfile (2 is a good default)
WEB_CONCURRENCY=2

# ---------- Security / CORS ----------
# Comma separated list of allowed browser origins for the API.
# Streamlit runs on 8501 by default.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_KEY=                          # optional; if set, /api/v1/scan/* requires X-API-Key

# ---------- Database ----------
# SQLite by default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scamshield
DATABASE_URL=sqlite:///./data/scamshield.db
DB_ECHO=false

# ---------- Machine learning ----------
MODEL_DIR=./models
VECTORIZER_DIR=./ml/vectorizers
ACTIVE_MODEL=model_logistic_regression.joblib
ML_SPAM_THRESHOLD=0.50

# ---------- Google Gemini (Generative AI) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_ENABLED=true

# ---------- Privacy ----------
# When true, raw message text is NOT persisted; only a salted hash + redacted preview.
# PRODUCTION: set to false so plaintext messages are never written to disk.
STORE_RAW_MESSAGE=true
PRIVACY_SALT=change-this-to-a-long-random-string
HISTORY_MAX_ROWS=5000

# ---------- Frontend ----------
API_BASE_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
