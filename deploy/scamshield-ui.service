# =============================================================
# systemd unit — ScamShield AI dashboard (Streamlit)
#
#   sudo cp deploy/scamshield-ui.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scamshield-ui
# =============================================================

[Unit]
Description=ScamShield AI Dashboard (Streamlit)
After=network-online.target scamshield-api.service
Wants=network-online.target
# Start the UI only after the API is up, so the first page load is healthy.
Requires=scamshield-api.service

[Service]
Type=simple
User=scamshield
Group=scamshield
WorkingDirectory=/opt/scamshield
EnvironmentFile=/opt/scamshield/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/scamshield
Environment=STREAMLIT_SERVER_PORT=8501
Environment=STREAMLIT_SERVER_ADDRESS=127.0.0.1
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

ExecStart=/opt/scamshield/.venv/bin/streamlit run frontend/app.py

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/scamshield/data

[Install]
WantedBy=multi-user.target
